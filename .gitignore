node_modules/
# ...and as a bare symlink, which "node_modules/" does not match (git worktrees use one).
node_modules
.wrangler/
dist/
.dev.vars
.env
*.local
.DS_Store
coverage/

# Internal working notes — these describe YOUR deployment (account email, live
# URLs, database ids) and have contained live tokens. Never publish.
HANDOFF.md
HANDOFF_SESSION_*.md

# Real production values for the maintainer's own instance. Never publish.
wrangler.prod.toml

# Local QA scaffolding created while validating a deploy against the live instance.
# qa/ imports from a sibling git worktree by absolute path, so it is machine-specific.
qa/
wrangler.qa.toml
